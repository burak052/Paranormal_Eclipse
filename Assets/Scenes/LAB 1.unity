  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Professor Arthur,\n\nThere is something unusual in the generator room.
    The system is running, but it does not feel stable. There are brief pauses and
    unexpected fluctuations. I have not intervened yet, as a wrong move might cause
    a bigger problem.\n\nI believe it would be best if you take a look.\n\n\u2014
    Generator Room Technician\n      Bob"
